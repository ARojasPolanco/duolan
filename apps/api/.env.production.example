# API - produccion
# Copiar como .env.production o cargar estas variables en el panel del proveedor.
# No commitear valores reales.

PORT=3000
NODE_ENV=production
# Un solo proxy (Render) = 1.
TRUST_PROXY=1
GAME_SERVER=LAN

# Dominio real de la web. Sin barra final. Separar varios origenes por coma.
CORS_ORIGIN=https://duolan.online,https://www.duolan.online
APP_URL=https://duolan.online

# Neon: usar la connection string con SSL.
DB_URI=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/REPLACE_DATABASE?sslmode=require
# TEST_DB_URI no se configura en produccion.

# Generar uno nuevo; nunca reutilizar el de desarrollo ni el de Duo LAS.
SECRET_JWT_SEED=REPLACE_WITH_RANDOM_64_CHARS
JWT_EXPIRE_IN=1d

# hCaptcha. Si falta, el captcha se salta.
HCAPTCHA_SECRET=REPLACE_WITH_HCAPTCHA_SECRET

# Resend. Si falta, no se envian emails.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
OWNER_EMAIL=noreply@duolan.online
SUPPORT_EMAIL=soporte@duolan.online

# Web push. Necesario antes de habilitar push.
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:soporte@duolan.online

# Riot API. Solo despues de la aprobacion de la production key.
# Nunca usar una key en el frontend.
# RIOT_API_KEY=REPLACE_WITH_RIOT_PRODUCTION_KEY
# RIOT_PLATFORM=la1
# RIOT_REGION=americas
# RIOT_API_TIMEOUT_MS=8000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_USER_MAX=600
LOG_LEVEL=info

# Solo para correr npm run seed:admin. Quitar despues del seed.
# ADMIN_EMAIL usa el mismo email que Duo LAS, configurado solo en Render.
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
