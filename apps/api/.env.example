# Server
PORT=3000
NODE_ENV=development
# Game server of this instance. DuoLAN only creates profiles for LAN.
GAME_SERVER=LAN
# Number of reverse proxies in front of Express (Render = 1).
TRUST_PROXY=1
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:4200
# Canonical public URL of the web app, used for emails and links.
APP_URL=http://localhost:4200

# Database
DB_URI=postgresql://duolan:duolan_local@localhost:5433/duolan
# Used by the test suite when NODE_ENV=test (keeps development data untouched).
TEST_DB_URI=postgresql://duolan:duolan_local@localhost:5433/duolan_test

# JWT
SECRET_JWT_SEED=change_this_to_a_random_string_of_at_least_64_characters
JWT_EXPIRE_IN=1d

# Captcha (hCaptcha). Optional in development and test.
# HCAPTCHA_SECRET=

# Email (Resend). Optional in development.
# RESEND_API_KEY=
# OWNER_EMAIL=onboarding@resend.dev
# TEST_EMAIL_TO=tu-casilla@dominio.com
SUPPORT_EMAIL=soporte@duolan.online

# Web push (VAPID). Required only when push is enabled.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@duolan.online

# Riot API. Not used by the MVP; server-side only when a production key is approved.
# RIOT_API_KEY=
# RIOT_PLATFORM=la1
# RIOT_REGION=americas
# RIOT_API_TIMEOUT_MS=8000

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_USER_MAX=600

# Logging
LOG_LEVEL=info

# Admin seed
# ADMIN_EMAIL=admin@duolan.online
# ADMIN_PASSWORD=change_this_password
