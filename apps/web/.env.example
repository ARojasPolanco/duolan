# Web build-time reference.
# Angular does NOT read .env automatically. The real values live in:
# - src/environments/environment.ts (development)
# - src/environments/environment.production.ts (production, committed)
# Do not put secrets here: everything in the web bundle is public.

API_URL=http://localhost:3000/api/v1
API_URL_PRODUCTION=https://api.duolan.online/api/v1
HCAPTCHA_SITE_KEY=
APP_URL=http://localhost:4200
APP_URL_PRODUCTION=https://duolan.online
